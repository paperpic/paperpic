{
  "name": "@paperpic/core",
  "type": "module",
  "version": "0.1.0",
  "description": "Framework-agnostic document image viewer and editor, for use with plain JavaScript or through a PaperPic wrapper.",
  "author": "Marco Caparrós <hello@paperpic.dev>",
  "license": "MIT",
  "homepage": "https://paperpic.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperpic/paperpic.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/paperpic/paperpic/issues",
  "keywords": [
    "document",
    "image",
    "perspective-correction",
    "threshold",
    "image-processing"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@tsdown/css": "0.23.4",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "6.0.3"
  }
}
