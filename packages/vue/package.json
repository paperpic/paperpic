{
  "name": "@paperpic/vue",
  "type": "module",
  "version": "0.2.0",
  "description": "Vue 3 components to view and edit document images with PaperPic.",
  "author": "Marco Caparrós <hello@paperpic.dev>",
  "license": "MIT",
  "homepage": "https://paperpic.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperpic/paperpic.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/paperpic/paperpic/issues",
  "keywords": [
    "document",
    "image",
    "perspective-correction",
    "threshold",
    "image-processing",
    "vue",
    "vue3"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@paperpic/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@tsdown/css": "0.23.7",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "unplugin-vue": "8.0.1",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
