{
  "name": "paperpic-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "dev": "pnpm --filter playground-vanilla dev",
    "dev:vue": "pnpm --filter playground-vue dev",
    "dev:dist": "pnpm --filter \"./packages/*\" build && pnpm --filter playground-vanilla dev:dist",
    "dev:vue:dist": "pnpm --filter \"./packages/*\" build && pnpm --filter playground-vue dev:dist",
    "dev:docs": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --cache && stylelint \"**/*.{css,vue}\" \"apps/docs/.vitepress/theme/**/*.{css,vue}\" --cache",
    "lint:fix": "stylelint \"**/*.{css,vue}\" \"apps/docs/.vitepress/theme/**/*.{css,vue}\" --cache --fix && eslint . --cache --fix",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
